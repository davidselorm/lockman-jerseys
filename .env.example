# ==========================================
# LOCKMAN JERSEYS - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public Configuration
# Retrieve from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used only for server-side admin operations)
# NEVER expose this on the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Authentication
# IMPORTANT: Before deploying to production, replace with a strong custom email & password
ADMIN_EMAIL=admin@lockmanjerseys.com
ADMIN_PASSWORD=SetAStrongProductionPassword123!
# Optional but recommended in production: 32+ character random secret for signing admin JWT sessions
ADMIN_SESSION_SECRET=replace-with-a-random-32-char-secret-key-for-session-tokens

# Store Settings Defaults
NEXT_PUBLIC_DEFAULT_WHATSAPP=
NEXT_PUBLIC_DEFAULT_SNAPCHAT=
